<?xml version="1.0" encoding="UTF-8"?>
<!-- Example LaunchAgent. ocrogram start generates this via service.Plist. Do not install this file as-is. -->
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>Label</key>
	<string>com.joelpeckham.ocrogram</string>
	<key>ProgramArguments</key>
	<array>
		<string>/path/to/ocrogram</string>
		<string>daemon</string>
	</array>
	<key>RunAtLoad</key>
	<true/>
	<key>KeepAlive</key>
	<dict>
		<key>SuccessfulExit</key>
		<false/>
	</dict>
	<key>StandardOutPath</key>
	<string>/Users/you/Library/Logs/ocrogram.log</string>
	<key>StandardErrorPath</key>
	<string>/Users/you/Library/Logs/ocrogram.log</string>
</dict>
</plist>
